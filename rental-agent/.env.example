# --- Claude (required) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- WhatsApp Business Cloud API (lets the agent chat with landlords on WhatsApp) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=rental_enquiry
WHATSAPP_TEMPLATE_LANG=en
PORT=8787

# --- Email (agent emails landlords and reads their replies) ---
# e.g. smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
EMAIL_FROM=
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=

# --- Notifications to you (set at least one) ---
# Install the ntfy app on your phone and subscribe to a hard-to-guess topic name.
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EMAIL=

# Optional
# RENTAL_DATA_DIR=data
# CHROMIUM_PATH=
