{
  "name": "hiraya-rental-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Finds short-term (2-3 month) rentals near Jurong West, Singapore, negotiates with landlords/agents, and notifies you when a call or viewing is booked.",
  "type": "module",
  "bin": {
    "rental-agent": "src/cli.ts"
  },
  "scripts": {
    "agent": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
